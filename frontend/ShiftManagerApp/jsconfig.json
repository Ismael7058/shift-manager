{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "checkJs": true,
        "strictNullChecks": true,
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "src/services/**/*",
        "src/models/**/*",
        "src/vite-env.d.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "build"
    ]
}